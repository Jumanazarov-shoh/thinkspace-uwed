# =====================================================================
# ThinkSpace | UWED Backend Environment Configuration (Production Template)
# Copy this file to .env and replace placeholders with real credentials.
# NEVER commit .env to version control!
# =====================================================================

# App & Environment
ENVIRONMENT=production
APP_NAME="ThinkSpace | UWED"
SECRET_KEY=generate-a-secure-random-32-char-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database (Supabase PostgreSQL in production, SQLite in local dev)
# Example Supabase pooled connection string:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
MINI_APP_URL=https://thinkspace.vercel.app
SUPER_ADMIN_TELEGRAM_ID=123456789

# CORS Origins (Comma-separated list of allowed web origins)
CORS_ORIGINS=https://thinkspace.vercel.app,http://localhost:5173

# Storage Configuration
# Set STORAGE_BACKEND=supabase for production persistent storage, or local for dev
STORAGE_BACKEND=supabase
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=submissions
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Localization & Preferences
DEFAULT_LANGUAGE=uz
