# ==============================================================================
# ThinkSpace | UWED — Environment Configuration
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env with real credentials into git.
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development

# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Mini App URL (e.g., https://your-domain.vercel.app or ngrok during testing)
MINI_APP_URL=http://localhost:5173

# Super Admin Bootstrap: Your personal Telegram ID (get it from @userinfobot)
# The user with this Telegram ID is automatically granted the Super Admin role on first contact.
SUPER_ADMIN_TELEGRAM_ID=0

# Secret key for JWT session tokens (generate a strong random 32+ character string)
SECRET_KEY=change-this-to-a-very-secure-random-string-at-least-32-chars-long

# Database Connection URL:
# For instant local development (no local PostgreSQL install required):
DATABASE_URL=sqlite+aiosqlite:///./thinkspace.db
# For production (PostgreSQL with asyncpg):
# DATABASE_URL=postgresql+asyncpg://thinkspace_user:password@localhost:5432/thinkspace_db

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Allowed CORS Origins (comma-separated or * for dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Default Language (uz / en)
DEFAULT_LANGUAGE=uz
