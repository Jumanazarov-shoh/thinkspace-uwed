# =====================================================================
# ThinkSpace | UWED Frontend Environment Configuration
# Safe browser-exposed variables only (prefixed with VITE_)
# NEVER put server secrets or database passwords in frontend env!
# =====================================================================

# Production Backend API URL (leave empty in local dev to use Vite proxy /api)
VITE_API_BASE_URL=https://your-backend.up.railway.app/api

# Telegram Bot username for Mini App deep links
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
